{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NARA Claimed Event Record",
  "type": "object",
  "properties": {
    "event_id": {"type": "string"},
    "issue_number": {"type": "integer"},
    "issue_date_hijri": {"type": ["string", "null"]},
    "issue_date_gregorian": {"type": ["string", "null"]},
    "source_page": {"type": ["integer", "null"]},
    "source_section": {"type": ["string", "null"]},
    "source_kind": {"enum": ["article", "weekly_infographic", "special_infographic", "editorial_reference", "other"]},
    "claimed_province": {"type": ["string", "null"]},
    "country": {"type": ["string", "null"]},
    "region_admin1": {"type": ["string", "null"]},
    "locality": {"type": ["string", "null"]},
    "event_date_text": {"type": ["string", "null"]},
    "event_type": {"enum": ["armed_attack", "explosive_attack", "ambush", "assassination", "raid", "shelling", "abduction_killing", "property_attack", "other", "unknown"]},
    "target_category": {"enum": ["military", "police_security", "militia", "government_official", "civilian", "religious_target", "infrastructure_property", "other", "unknown"]},
    "claimed_killed": {"type": ["integer", "null"], "minimum": 0},
    "claimed_injured": {"type": ["integer", "null"], "minimum": 0},
    "claimed_killed_injured_combined": {"type": ["integer", "null"], "minimum": 0},
    "claimed_captured": {"type": ["integer", "null"], "minimum": 0},
    "claimed_vehicles_damaged_destroyed": {"type": ["integer", "null"], "minimum": 0},
    "claimed_buildings_sites_damaged": {"type": ["integer", "null"], "minimum": 0},
    "claim_text_summary": {"type": ["string", "null"]},
    "confidence_status": {"enum": ["claimed", "corroborated", "verified", "disputed"]},
    "independent_sources_count": {"type": "integer", "minimum": 0, "default": 0},
    "duplicate_group_id": {"type": ["string", "null"]},
    "included_in_weekly_infographic": {"type": "boolean"},
    "notes": {"type": ["string", "null"]}
  },
  "required": ["event_id", "issue_number", "source_kind", "event_type", "target_category", "confidence_status", "included_in_weekly_infographic"]
}
